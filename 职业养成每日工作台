  if(repeat==="weekly" && !weekDays.length){ toast("请选择每周几执行"); return; }
  const monthDay = +document.getElementById("fMonthDay").value;
  const start = document.getElementById("fStart").value;
  const due = document.getElementById("fDue").value;
  const data = {text, trackId, xp, repeat, weekDays, monthDay, start, due};
  if(editingTaskId){
    const t = state.tasks.find(x=>x.id===editingTaskId);
    Object.assign(t, data);
    toast("任务已更新");
  }else{
    state.tasks.push({id:uid(), ...data, done:{}});
    toast("新任务已加入队列");
  }
  save(); closeTaskModal(); renderAll();
}

/* ================= 赛道弹窗 ================= */
let editingTrackId = null;
let trackColor = TRACK_COLORS[0];
function openTrackModal(editId){
  editingTrackId = editId||null;
  const tr = editId? state.tracks.find(x=>x.id===editId):null;
  document.getElementById("trackModalTitle").textContent = tr?"编辑赛道":"新建赛道";
  document.getElementById("tName").value = tr?tr.name:"";
  document.getElementById("tTag").value = tr?(tr.tag||""):"";
  document.getElementById("tGoal").value = tr?tr.goal:500;
  trackColor = tr?tr.color:TRACK_COLORS[0];
  renderSwatches();
  document.getElementById("tDelete").style.display = tr?"":"none";
  document.getElementById("trackModalMask").classList.add("show");
}
function renderSwatches(){
  document.getElementById("tColors").innerHTML = TRACK_COLORS.map(c=>
    `<div class="swatch ${c===trackColor?"active":""}" data-color="${c}" style="background:${c}"></div>`).join("");
}
function closeTrackModal(){ document.getElementById("trackModalMask").classList.remove("show"); }
function saveTrack(){
  const name = document.getElementById("tName").value.trim();
  if(!name){ toast("请填写赛道名称"); return; }
  const data = {name, tag:document.getElementById("tTag").value.trim(),
    goal:Math.max(50,+document.getElementById("tGoal").value||500), color:trackColor};
  if(editingTrackId){
    Object.assign(state.tracks.find(x=>x.id===editingTrackId), data);
    toast("赛道已更新");
  }else{
    state.tracks.push({id:uid(), ...data});
    toast("新赛道已创建");
  }
  save(); closeTrackModal(); renderAll();
}

/* ================= 成就弹窗 ================= */
function closeAchModal(){ document.getElementById("achModalMask").classList.remove("show"); }
function saveCustomAch(){
  const name = document.getElementById("aName").value.trim();
  const desc = document.getElementById("aDesc").value.trim();
  const type = document.getElementById("aType").value;
  const target = Math.max(1,+document.getElementById("aTarget").value||1);
  if(!name){ toast("请填写成就名称"); return; }
  state.customAch.push({id:uid(), name, desc:desc||"自定义成就", type, target});
  checkAchievements();
  save(); closeAchModal(); renderAll();
  toast("自定义成就已加入成就墙");
}

/* ================= 事件绑定 ================= */
function bindEvents(){
  // 导航
  document.querySelectorAll("#navTabs button").forEach(b=>{
    b.addEventListener("click", ()=>switchView(b.dataset.view));
  });
  // 任务勾选
  document.addEventListener("change", e=>{
    const lab = e.target.closest("label.task");
    if(!lab) return;
    const task = state.tasks.find(x=>x.id===lab.dataset.task);
    if(!task) return;
    const ds = lab.dataset.date||todayStr();
    const today = todayStr();
    const checked = e.target.checked;
    if(ds!==today){
      task.done[ds] = checked; save(); renderAll(); return;
    }
    normalizeCounters();
    if(checked){
      task.done[today]=true;
      grant(task.xp, task.trackId);
      state.counters.perTrackCount[task.trackId]=(state.counters.perTrackCount[task.trackId]||0)+1;
      state.counters.monthCount[monthKey()]=(state.counters.monthCount[monthKey()]||0)+1;
      toast(`任务完成 · <b>+${task.xp} XP</b>`);
    }else{
      delete task.done[today];
      revoke(task.xp, task.trackId);
      state.counters.perTrackCount[task.trackId]=Math.max(0,(state.counters.perTrackCount[task.trackId]||0)-1);
      state.counters.monthCount[monthKey()]=Math.max(0,(state.counters.monthCount[monthKey()]||0)-1);
    }
    checkAchievements(); save(); renderAll();
  });
  // 编辑 / 新建按钮委托
  document.addEventListener("click", e=>{
    const edit = e.target.closest("[data-edit]");
    if(edit){ e.preventDefault(); openTaskModal(edit.dataset.edit); return; }
    const newTask = e.target.closest("[data-track-newtask]");
    if(newTask){ e.preventDefault(); openTaskModal(null, newTask.dataset.trackNewtask); return; }
  });
  // 顶部新建任务
  document.getElementById("btnNewTaskToday").addEventListener("click", ()=>openTaskModal());
  document.getElementById("btnNewTaskToday2").addEventListener("click", ()=>openTaskModal());
  // 任务弹窗
  document.getElementById("fRepeat").addEventListener("change", toggleRepeatRows);
  document.getElementById("fSave").addEventListener("click", saveTask);
  document.getElementById("fCancel").addEventListener("click", closeTaskModal);
  document.getElementById("fDelete").addEventListener("click", ()=>{
    if(!editingTaskId) return;
    if(confirm("确定删除这个任务？历史完成记录一并移除。")){
      state.tasks = state.tasks.filter(x=>x.id!==editingTaskId);
      save(); closeTaskModal(); renderAll(); toast("任务已删除");
    }
  });
  document.getElementById("taskModalMask").addEventListener("click", e=>{ if(e.target===e.currentTarget) closeTaskModal(); });
  // 赛道弹窗
  document.getElementById("btnNewTrack").addEventListener("click", ()=>openTrackModal());
  document.getElementById("trackManage").addEventListener("click", e=>{
    const ed = e.target.closest("[data-track-edit]");
    if(ed) openTrackModal(ed.dataset.trackEdit);
  });
  document.getElementById("tSave").addEventListener("click", saveTrack);
  document.getElementById("tCancel").addEventListener("click", closeTrackModal);
  document.getElementById("tDelete").addEventListener("click", ()=>{
    if(!editingTrackId) return;
    if(confirm("删除赛道将同时删除其下全部任务，确定继续？")){
      state.tasks = state.tasks.filter(x=>x.trackId!==editingTrackId);
      state.tracks = state.tracks.filter(x=>x.id!==editingTrackId);
      save(); closeTrackModal(); renderAll(); toast("赛道已删除");
    }
  });
  document.getElementById("trackModalMask").addEventListener("click", e=>{ if(e.target===e.currentTarget) closeTrackModal(); });
  document.getElementById("tColors").addEventListener("click", e=>{
    const sw = e.target.closest(".swatch");
    if(sw){ trackColor = sw.dataset.color; renderSwatches(); }
  });
  // 成就弹窗
  document.getElementById("btnNewAch").addEventListener("click", ()=>{
    document.getElementById("aName").value=""; document.getElementById("aDesc").value="";
    document.getElementById("aType").value="xp"; document.getElementById("aTarget").value=100;
    document.getElementById("achModalMask").classList.add("show");
  });
  document.getElementById("aSave").addEventListener("click", saveCustomAch);
  document.getElementById("aCancel").addEventListener("click", closeAchModal);
  document.getElementById("achModalMask").addEventListener("click", e=>{ if(e.target===e.currentTarget) closeAchModal(); });
  // 日历
  document.getElementById("calPrev").addEventListener("click", ()=>{ calCursor=new Date(calCursor.getFullYear(),calCursor.getMonth()-1,1); renderCalendar(); });
  document.getElementById("calNext").addEventListener("click", ()=>{ calCursor=new Date(calCursor.getFullYear(),calCursor.getMonth()+1,1); renderCalendar(); });
  document.getElementById("calToday").addEventListener("click", ()=>{ calCursor=new Date(); selectedDate=todayStr(); renderCalendar(); });
  document.getElementById("calBody").addEventListener("click", e=>{
    const cell = e.target.closest(".cal-cell");
    if(!cell) return;
    selectedDate = cell.dataset.date; renderCalendar();
  });
  // 月报
  document.getElementById("btnMonthlyReview").addEventListener("click", monthlyReview);
  // 昵称
  document.getElementById("nickInput").addEventListener("change", e=>{
    state.nickname = e.target.value.trim()||"旅人"; save(); renderHUD(); toast("昵称已保存");
  });
  // 起卦
  document.getElementById("btnGuaCast").addEventListener("click", castFromInput);
  document.getElementById("guaInput").addEventListener("keydown", e=>{ if(e.key==="Enter") castFromInput(); });
  // AI 设置
  document.getElementById("aiProvider").addEventListener("change", ()=>{
    aiSettings.provider = document.getElementById("aiProvider").value;
    refreshAiStatus();
  });
  document.getElementById("btnSaveAi").addEventListener("click", saveAiSettings);
  // 八字排盘
  document.getElementById("btnBaziCast").addEventListener("click", castBazi);
  // AI 生成按钮委托
  document.addEventListener("click", e=>{
    const act = e.target.closest("[data-action]");
    if(!act) return;
    if(act.dataset.action==="gua-ai") runGuaAi();
    if(act.dataset.action==="bazi-ai") runBaziAi();
  });
  // 导出 / 重置
  const wrap = document.querySelector(".wrap");
  const exp = document.createElement("button");
  exp.className="btn ghost sm"; exp.textContent="导出进度";
  exp.addEventListener("click", ()=>{
    const blob = new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
    const a = document.createElement("a"); a.href=URL.createObjectURL(blob);
    a.download=`工作台进度_${todayStr()}.json`; a.click(); URL.revokeObjectURL(a.href);
    toast("进度已导出为 JSON");
  });
  const rst = document.createElement("button");
  rst.className="btn danger sm"; rst.textContent="重置全部进度";
  rst.addEventListener("click", ()=>{
    if(confirm("确定清空等级、经验、任务与成就？此操作不可恢复。")){
      state = defaultState(); state.lastActive=todayStr();
      save(); renderAll(); toast("进度已重置");
    }
  });
  const bar = document.createElement("div");
  bar.style.cssText="display:flex;gap:10px;margin-top:22px;flex-wrap:wrap;justify-content:flex-end;";
  bar.appendChild(exp); bar.appendChild(rst);
  document.querySelector(".wrap").appendChild(bar);
}
function castFromInput(){
  const raw = document.getElementById("guaInput").value.trim();
  const g = castGua(raw);
  if(!g){ toast("请输入有效数字，如 1353 或 13 53"); return; }
  currentGua = g; currentGuaRaw = raw;
  document.getElementById("guaResult").style.display="block";
  renderGuaCards(g); renderLocalGua(g, raw);
}

