<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>职业养成工作台 · 任务 / 日历 / 成就 / 起卦</title>
<link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="%230e1416"/><path d="M16 6l9 5-9 5-9-5 9-5z" fill="none" stroke="%23e8a84e" stroke-width="2" stroke-linejoin="round"/><path d="M7 16l9 5 9-5M7 20l9 5 9-5" fill="none" stroke="%235fc4ae" stroke-width="2" stroke-linejoin="round"/></svg>'>
<style>
:root{
  --bg:#0e1416; --bg2:#0b1011; --panel:#162023; --panel2:#1d292c;
  --line:#2b3a3e; --line-soft:#223033;
  --text:#ece4d3; --muted:#8fa3a1; --faint:#647776;
  --gold:#e8a84e; --teal:#5fc4ae; --red:#d9725f; --violet:#9a8bd0; --blue:#6ea8d8;
  --radius:14px;
  --mono:"SF Mono",ui-monospace,"Cascadia Mono",Consolas,monospace;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  line-height:1.55;min-height:100vh;
  background-image:radial-gradient(900px 500px at 85% -10%,rgba(232,168,78,.07),transparent 60%),radial-gradient(800px 500px at -10% 30%,rgba(95,196,174,.06),transparent 55%);
}
.wrap{max-width:1180px;margin:0 auto;padding:20px 18px 80px;}
button{font-family:inherit;}
input,select,textarea{font-family:inherit;color:var(--text);}

/* ===== 顶部 ===== */
header.hero{display:grid;grid-template-columns:1.35fr 1fr;gap:16px;margin-bottom:16px;}
.hero-left{background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);padding:22px 24px;position:relative;overflow:hidden;}
.hero-left::after{content:"";position:absolute;right:-60px;top:-60px;width:190px;height:190px;border:1px dashed rgba(232,168,78,.16);border-radius:50%;}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.22em;color:var(--gold);text-transform:uppercase;margin-bottom:8px;}
.hero-left h1{font-size:26px;font-weight:800;margin-bottom:6px;}
.hero-left h1 em{font-style:normal;color:var(--gold);}
.hero-left p{color:var(--muted);font-size:13.5px;max-width:54ch;}
.date-line{margin-top:12px;font-family:var(--mono);font-size:12.5px;color:var(--faint);}
.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);}
.hud{padding:16px 18px;display:flex;flex-direction:column;gap:12px;}
.hud-top{display:flex;align-items:center;justify-content:space-between;gap:10px;}
.nick{font-size:16px;font-weight:700;background:transparent;border:1px solid transparent;color:var(--text);border-radius:8px;padding:4px 8px;max-width:150px;}
.nick:focus{outline:none;border-color:var(--gold);background:var(--bg2);}
.rank-badge{font-family:var(--mono);font-size:12px;color:var(--bg);background:var(--gold);padding:3px 10px;border-radius:99px;font-weight:700;white-space:nowrap;}
.xp-block{display:flex;flex-direction:column;gap:6px;}
.xp-label{display:flex;justify-content:space-between;font-size:12.5px;color:var(--muted);font-family:var(--mono);}
.bar{height:10px;border-radius:99px;background:var(--bg2);overflow:hidden;border:1px solid var(--line-soft);}
.bar>i{display:block;height:100%;border-radius:99px;transition:width .5s cubic-bezier(.2,.8,.2,1);}
.bar.gold>i{background:linear-gradient(90deg,#c9842f,var(--gold));}
.hud-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.stat{background:var(--bg2);border:1px solid var(--line-soft);border-radius:10px;padding:9px 12px;}
.stat b{display:block;font-family:var(--mono);font-size:18px;font-weight:700;color:var(--gold);}
.stat span{font-size:11.5px;color:var(--muted);}

/* ===== 导航 ===== */
nav.tabs{display:flex;gap:6px;background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);padding:6px;margin-bottom:18px;overflow-x:auto;}
nav.tabs button{
  flex:1;min-width:110px;background:transparent;border:none;color:var(--muted);
  padding:10px 12px;border-radius:10px;font-size:14px;cursor:pointer;white-space:nowrap;
  display:flex;align-items:center;justify-content:center;gap:7px;
}
nav.tabs button svg{width:17px;height:17px;}
nav.tabs button.active{background:var(--panel2);color:var(--text);font-weight:700;}
nav.tabs button.active svg{stroke:var(--gold);}

.view{display:none;}
.view.active{display:block;}
.section-title{font-size:13px;letter-spacing:.16em;color:var(--muted);font-family:var(--mono);margin:6px 0 12px;text-transform:uppercase;display:flex;align-items:center;gap:10px;}
.section-title .spacer{flex:1;}

/* ===== 按钮 ===== */
.btn{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:9px 15px;font-size:13px;cursor:pointer;}
.btn:hover{filter:brightness(1.12);}
.btn.primary{background:var(--gold);color:var(--bg);border-color:var(--gold);font-weight:700;}
.btn.ghost{background:transparent;}
.btn.danger{color:var(--red);border-color:rgba(217,114,95,.35);}
.btn.sm{padding:6px 11px;font-size:12.5px;border-radius:8px;}

/* ===== 任务行 ===== */
.task-group{margin-bottom:18px;}
.group-head{display:flex;align-items:center;gap:10px;margin:14px 0 10px;}
.group-dot{width:10px;height:10px;border-radius:3px;flex:none;}
.group-name{font-size:15px;font-weight:700;}
.group-meta{font-size:12px;color:var(--faint);font-family:var(--mono);}
.task-list{display:flex;flex-direction:column;gap:7px;}
.task{
  display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:11px;
  background:var(--bg2);border:1px solid transparent;cursor:pointer;
}
.task:hover{border-color:var(--line);}
.task.done{opacity:.55;}
.task.done .task-text{text-decoration:line-through;}
.task input[type=checkbox]{appearance:none;width:18px;height:18px;border:1.5px solid var(--faint);border-radius:6px;flex:none;position:relative;cursor:pointer;}
.task input[type=checkbox]:checked{background:var(--gold);border-color:var(--gold);}
.task input[type=checkbox]:checked::after{content:"";position:absolute;left:5.5px;top:2px;width:5px;height:9px;border:solid #0e1416;border-width:0 2px 2px 0;transform:rotate(45deg);}
.task-main{flex:1;min-width:0;}
.task-text{font-size:13.5px;}
.task-sub{font-size:11.5px;color:var(--faint);margin-top:2px;font-family:var(--mono);}
.task-xp{font-family:var(--mono);font-size:11.5px;color:var(--faint);white-space:nowrap;}
.task-ops{display:flex;gap:4px;flex:none;}
.task-ops button{background:transparent;border:none;color:var(--faint);cursor:pointer;padding:5px;border-radius:7px;}
.task-ops button:hover{color:var(--text);background:var(--panel2);}
.task-ops svg{width:15px;height:15px;display:block;}
.empty{padding:26px 14px;text-align:center;color:var(--faint);font-size:13px;border:1px dashed var(--line-soft);border-radius:12px;}

/* ===== 今日布局 ===== */
.today-grid{display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start;}
.side-panel{padding:16px 18px;display:flex;flex-direction:column;gap:12px;}
.mini-stat{display:flex;justify-content:space-between;align-items:center;background:var(--bg2);border:1px solid var(--line-soft);border-radius:10px;padding:11px 13px;}
.mini-stat b{font-family:var(--mono);color:var(--gold);}
.mini-stat span{font-size:12.5px;color:var(--muted);}

/* ===== 日历 ===== */
.cal-grid{display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start;}
.cal-card{padding:18px;}
.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px;}
.cal-head h3{font-size:16px;font-weight:700;}
.cal-nav{display:flex;gap:6px;}
.cal-week{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:5px;}
.cal-week span{text-align:center;font-size:12px;color:var(--faint);font-family:var(--mono);padding:5px 0;}
.cal-body{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;}
.cal-cell{
  min-height:86px;background:var(--bg2);border:1px solid var(--line-soft);border-radius:10px;
  padding:6px 7px;cursor:pointer;display:flex;flex-direction:column;gap:4px;
}
.cal-cell:hover{border-color:var(--line);}
.cal-cell.other{opacity:.32;}
.cal-cell.today{border-color:var(--gold);}
.cal-cell.selected{border-color:var(--teal);background:var(--panel2);}
.cal-date{font-family:var(--mono);font-size:12px;color:var(--muted);}
.cal-cell.today .cal-date{color:var(--gold);font-weight:700;}
.cal-dots{display:flex;flex-direction:column;gap:3px;}
.cal-chip{font-size:10.5px;padding:2px 6px;border-radius:5px;color:#0e1416;font-weight:600;line-height:1.4;overflow:hidden;max-width:100%;white-space:nowrap;text-overflow:ellipsis;}
.cal-detail{padding:16px 18px;}
.cal-detail h4{font-size:14px;margin-bottom:12px;}
.long-list{display:flex;flex-direction:column;gap:14px;margin-top:18px;}
.long-block h4{font-size:13px;color:var(--muted);font-family:var(--mono);letter-spacing:.1em;margin-bottom:8px;}

/* ===== 成就 ===== */
.ach-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.ach{display:flex;gap:11px;align-items:center;background:var(--bg2);border:1px solid var(--line-soft);border-radius:12px;padding:13px;}
.ach.locked{opacity:.38;}
.ach-icon{width:38px;height:38px;flex:none;border-radius:10px;background:var(--panel2);display:flex;align-items:center;justify-content:center;}
.ach-icon svg{width:21px;height:21px;stroke:var(--muted);}
.ach.unlocked .ach-icon{background:rgba(232,168,78,.14);}
.ach.unlocked .ach-icon svg{stroke:var(--gold);}
.ach b{font-size:13.5px;display:block;}
.ach span{font-size:11.5px;color:var(--faint);display:block;}
.ach .prog{font-family:var(--mono);font-size:11px;color:var(--teal);}
.form-row{display:flex;flex-direction:column;gap:6px;margin-bottom:12px;}
.form-row label{font-size:12.5px;color:var(--muted);}
.form-row input,.form-row select,.form-row textarea{
  background:var(--bg2);border:1px solid var(--line);border-radius:9px;padding:9px 11px;font-size:14px;
}
.form-row input:focus,.form-row select:focus,.form-row textarea:focus{outline:none;border-color:var(--gold);}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.check-pills{display:flex;flex-wrap:wrap;gap:7px;}
.check-pills label{display:flex;align-items:center;gap:5px;font-size:13px;color:var(--text);cursor:pointer;background:var(--bg2);border:1px solid var(--line-soft);border-radius:8px;padding:7px 11px;}
.check-pills input{accent-color:var(--gold);}

/* ===== 赛道管理 ===== */
.track-manage{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
.track-card{background:var(--bg2);border:1px solid var(--line-soft);border-radius:13px;padding:16px;display:flex;flex-direction:column;gap:10px;}
.track-card .t-head{display:flex;align-items:center;gap:10px;}
.track-card .t-name{font-size:15px;font-weight:700;flex:1;}
.track-card .t-tag{font-size:11.5px;color:var(--faint);}
.track-card .t-xp{font-family:var(--mono);font-size:12.5px;color:var(--muted);}
.color-swatches{display:flex;gap:7px;flex-wrap:wrap;}
.swatch{width:24px;height:24px;border-radius:7px;cursor:pointer;border:2px solid transparent;}
.swatch.active{border-color:var(--text);}

/* ===== 起卦 ===== */
.oracle-box{padding:20px;display:flex;flex-direction:column;gap:18px;}
.gua-result{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.gua-card{background:var(--bg2);border:1px solid var(--line-soft);border-radius:13px;padding:15px;}
.gua-card h4{font-size:13px;color:var(--muted);font-family:var(--mono);margin-bottom:10px;letter-spacing:.08em;}
.gua-lines{display:flex;flex-direction:column-reverse;gap:7px;align-items:center;padding:6px 0;}
.yao{width:100%;height:11px;border-radius:3px;position:relative;}
.yao.yang{background:var(--text);}
.yao.yin{background:linear-gradient(90deg,var(--text) 42%,transparent 42%,transparent 58%,var(--text) 58%);}
.yao.dong{outline:2px solid var(--gold);outline-offset:2px;}
.yao-mark{position:absolute;right:-4px;top:50%;transform:translateY(-50%);font-size:10px;color:var(--gold);font-family:var(--mono);}
.gua-name{font-size:16px;font-weight:700;margin-top:10px;}
.gua-note{font-size:12.5px;color:var(--muted);margin-top:5px;}
.interpret{background:var(--bg2);border:1px solid var(--line-soft);border-radius:13px;padding:16px 18px;display:flex;flex-direction:column;gap:10px;}
.interpret h4{font-size:13px;color:var(--muted);font-family:var(--mono);letter-spacing:.1em;}
.interpret p{font-size:13.5px;color:var(--text);}
.interpret .tag-line{display:flex;gap:8px;flex-wrap:wrap;}
.tag{font-size:12px;padding:4px 11px;border-radius:99px;background:var(--panel2);color:var(--muted);}
.tag.good{color:var(--teal);background:rgba(95,196,174,.12);}
.tag.warn{color:var(--gold);background:rgba(232,168,78,.12);}
details.fortune{background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);overflow:hidden;}
details.fortune summary{cursor:pointer;padding:16px 18px;display:flex;align-items:center;gap:12px;list-style:none;}
details.fortune summary::-webkit-details-marker{display:none;}
details.fortune summary .chev{margin-left:auto;transition:transform .25s;color:var(--muted);}
details.fortune[open] summary .chev{transform:rotate(90deg);}
.fortune-body{padding:0 18px 18px;display:flex;flex-direction:column;gap:16px;}
.bazi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
.bazi-cell{background:var(--bg2);border:1px solid var(--line-soft);border-radius:11px;padding:12px;text-align:center;}
.bazi-cell .pillar{font-family:var(--mono);font-size:18px;font-weight:700;color:var(--gold);}
.bazi-cell .role{font-size:11.5px;color:var(--muted);margin-top:3px;}
.bazi-cell .nayin{font-size:11px;color:var(--faint);margin-top:2px;}
.disclaimer{font-size:12px;color:var(--faint);border-left:2px solid var(--line);padding-left:12px;}

/* ===== AI 设置 / 排盘表单 ===== */
.ai-status{font-size:12px;font-family:var(--mono);padding:4px 11px;border-radius:99px;}
.ai-status.on{color:var(--teal);background:rgba(95,196,174,.12);}
.ai-status.off{color:var(--faint);background:var(--panel2);}
.provider-note{font-size:12px;color:var(--faint);line-height:1.6;}
.bazi-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.bazi-form .form-row:last-child{grid-column:1/-1;}
.muted-note{font-size:12.5px;color:var(--muted);margin-top:12px;line-height:1.7;}
.ai-result{background:var(--bg2);border:1px solid var(--line-soft);border-radius:12px;padding:15px 17px;display:flex;flex-direction:column;gap:9px;font-size:13.5px;line-height:1.75;}
.ai-result h5{font-size:13.5px;color:var(--gold);margin-top:4px;}
.ai-result p{font-size:13.5px;}
.ai-result .ai-foot{font-size:11.5px;color:var(--faint);border-top:1px solid var(--line-soft);padding-top:9px;}
.ai-loading{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:13px;padding:14px 4px;}
.spinner{width:15px;height:15px;border:2px solid var(--line);border-top-color:var(--gold);border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.ai-btn-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.ai-hint{font-size:12px;color:var(--faint);}
.oracle-input-row{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;}
.oracle-input-row .form-row{flex:1;min-width:220px;margin-bottom:0;}

/* ===== 月报 ===== */
.report-card{background:var(--bg2);border:1px solid var(--line-soft);border-radius:13px;padding:18px;display:flex;flex-direction:column;gap:12px;}
.report-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
.report-bar{display:flex;flex-direction:column;gap:5px;}
.report-bar .r-label{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);}
.report-bar .bar>i{height:8px;}
.report-text{font-size:13.5px;color:var(--text);display:flex;flex-direction:column;gap:8px;}
.report-text li{margin-left:18px;}

/* ===== 弹窗 ===== */
.modal-mask{position:fixed;inset:0;background:rgba(5,8,9,.72);display:none;align-items:center;justify-content:center;padding:18px;z-index:40;}
.modal-mask.show{display:flex;}
.modal{background:var(--panel);border:1px solid var(--line);border-radius:16px;width:100%;max-width:520px;max-height:88vh;overflow-y:auto;padding:22px;}
.modal h3{font-size:17px;margin-bottom:16px;}
.modal-foot{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;}
.toast{position:fixed;left:50%;bottom:36px;transform:translateX(-50%) translateY(20px);background:var(--panel2);border:1px solid var(--gold);color:var(--text);padding:10px 18px;border-radius:11px;font-size:13.5px;opacity:0;pointer-events:none;transition:all .3s;z-index:60;max-width:90vw;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
.toast b{color:var(--gold);font-family:var(--mono);}

@media (max-width:900px){
  header.hero{grid-template-columns:1fr;}
  .today-grid,.cal-grid{grid-template-columns:1fr;}
  .ach-grid{grid-template-columns:repeat(2,1fr);}
  .track-manage{grid-template-columns:1fr;}
  .gua-result{grid-template-columns:1fr;}
  .report-grid{grid-template-columns:repeat(2,1fr);}
  .bazi-form{grid-template-columns:1fr;}
}
@media (max-width:480px){
  .wrap{padding:14px 12px 60px;}
  .hero-left{padding:18px;}
  .hero-left h1{font-size:21px;}
  .bazi-row{grid-template-columns:repeat(2,1fr);}
  .form-grid{grid-template-columns:1fr;}
  .cal-cell{min-height:64px;}
}
</style>
</head>
<body>
<div class="wrap">

  <header class="hero">
    <div class="hero-left">
      <div class="eyebrow">Quest Board · 任务 / 日历 / 成就 / 起卦</div>
      <h1>职业养成 <em>工作台</em></h1>
      <p>任务可按日、周、月与一次性长线安排，日历看板排期，成就与等级驱动持续投入。</p>
      <div class="date-line" id="dateLine"></div>
    </div>
    <div class="card hud">
      <div class="hud-top">
        <input class="nick" id="nickInput" maxlength="10" placeholder="点击改名" aria-label="昵称">
        <span class="rank-badge" id="rankBadge">Lv.1</span>
      </div>
      <div class="xp-block">
        <div class="xp-label"><span id="rankName">见习旅人</span><span id="xpText">0 / 120 XP</span></div>
        <div class="bar gold"><i id="xpBar" style="width:0%"></i></div>
      </div>
      <div class="hud-stats">
        <div class="stat"><b id="streakStat">0</b><span>连续打卡</span></div>
        <div class="stat"><b id="todayStat">0</b><span>今日经验</span></div>
        <div class="stat"><b id="totalStat">0</b><span>累计经验</span></div>
      </div>
    </div>
  </header>

  <nav class="tabs" id="navTabs">
    <button data-view="today" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/></svg>今日任务</button>
    <button data-view="calendar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18M8 14h3"/></svg>日历看板</button>
    <button data-view="achievements"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 22l5-3 5 3-1.5-8"/></svg>成就墙</button>
    <button data-view="tracks"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 7h18M3 12h18M3 17h18"/></svg>赛道管理</button>
    <button data-view="oracle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 9-7 9-7-9 7-9z"/></svg>天命起卦</button>
  </nav>

  <section class="view active" id="view-today">
    <div class="today-grid">
