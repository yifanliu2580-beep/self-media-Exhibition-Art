/* ================= 月度军师 ================= */
function renderReview(){
  const box = document.getElementById("reportBody");
  const mk = monthKey();
  if(state.reviewMonth !== mk){ box.innerHTML = ""; return; }
  const ms = monthStats();
  normalizeCounters();
  const longN = state.tasks.filter(t=>t.repeat==="once"&&inRange(t,todayStr())).length;
  // 赛道分布
  const rows = state.tracks.map(tr=>{
    const c = state.counters.perTrackCount[tr.id]||0;
    return {tr, c};
  }).sort((a,b)=>b.c-a.c);
  const maxC = Math.max(1,...rows.map(r=>r.c));
  const bars = rows.map(r=>`
    <div class="report-bar">
      <div class="r-label"><span>${escapeHtml(r.tr.name)}</span><span>${r.c} 次</span></div>
      <div class="bar"><i style="width:${Math.round(r.c/maxC*100)}%;background:${r.tr.color}"></i></div>
    </div>`).join("");
  const weakest = rows[rows.length-1];
  const tips = [];
  tips.push(`本月累计 <b>${ms.xp} XP</b>、完成 <b>${ms.count}</b> 个任务，当前连续打卡 <b>${state.streak}</b> 天。`);
  if(weakest && weakest.c===0){
    tips.push(`「${escapeHtml(weakest.tr.name)}」本月尚未推进，建议下月把它设为保底支线，每天先完成 1 个最小任务破冰。`);
  }else if(weakest){
    tips.push(`投入最少的是「${escapeHtml(weakest.tr.name)}」（${weakest.c} 次），下月可在日历上为它固定 2 个时间槽，避免被主线挤掉。`);
  }
  if(state.streak<3) tips.push(`连击还短，优先保住每日最低限度的一件小事，比偶尔冲刺更能维持状态。`);
  tips.push(`长线任务保留 ${longN} 项在推进中，建议每月复盘时核对截止日期，临近的提前两周拆成小步骤。`);
  box.innerHTML = `
    <div class="report-grid">
      <div class="stat"><b>${ms.xp}</b><span>本月 XP</span></div>
      <div class="stat"><b>${ms.count}</b><span>本月完成</span></div>
      <div class="stat"><b>${state.streak}</b><span>当前连击</span></div>
      <div class="stat"><b>${longN}</b><span>长线任务</span></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px">${bars}</div>
    <ul class="report-text">${tips.map(t=>`<li>${t}</li>`).join("")}</ul>`;
}
