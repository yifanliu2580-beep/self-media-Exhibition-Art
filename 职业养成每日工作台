/* ================= XP 结算 ================= */
function grant(xp, trackId){
  state.totalXP += xp;
  const ds = todayStr();
  state.counters.dayXp[ds] = (state.counters.dayXp[ds]||0)+xp;
  state.counters.weekXp += xp;
  state.counters.all += 1;
  if(trackId){
    state.counters.perTrack[trackId] = (state.counters.perTrack[trackId]||0)+xp;
  }
}
function revoke(xp, trackId){
  state.totalXP = Math.max(0,state.totalXP-xp);
  const ds = todayStr();
  state.counters.dayXp[ds] = Math.max(0,(state.counters.dayXp[ds]||0)-xp);
  state.counters.weekXp = Math.max(0,state.counters.weekXp-xp);
  state.counters.all = Math.max(0,state.counters.all-1);
  if(trackId) state.counters.perTrack[trackId] = Math.max(0,(state.counters.perTrack[trackId]||0)-xp);
}

