let calCursor = new Date();
let selectedDate = todayStr();
function renderCalendar(){
  const y = calCursor.getFullYear(), m = calCursor.getMonth();
  document.getElementById("calTitle").textContent = `${y} 年 ${m+1} 月`;
  const first = new Date(y,m,1);
  const startPad = isoWeekDay(first)-1; // 周一起始
  const daysInMonth = new Date(y,m+1,0).getDate();
  const body = document.getElementById("calBody");
  let html = "";
  for(let i=0;i<42;i++){
    const dayNum = i-startPad+1;
    const d = new Date(y,m,dayNum);
    const ds = dateStr(d);
    const inMonth = dayNum>=1 && dayNum<=daysInMonth;
    const dayTasks = state.tasks.filter(t=>taskOnDate(t,d));
    const chips = dayTasks.slice(0,3).map(t=>{
      const tr = trackById(t.trackId)||{color:"#888"};
      return `<div class="cal-chip" style="background:${tr.color}">${escapeHtml(t.text.slice(0,9))}</div>`;
    }).join("");
    const more = dayTasks.length>3?`<div class="cal-chip" style="background:#334246">+${dayTasks.length-3}</div>`:"";
    const cls = ["cal-cell"];
    if(!inMonth) cls.push("other");
    if(ds===todayStr()) cls.push("today");
    if(ds===selectedDate) cls.push("selected");
    html += `<div class="${cls.join(" ")}" data-date="${ds}">
      <div class="cal-date">${inMonth?dayNum:""}</div>
      <div class="cal-dots">${chips}${more}</div>
    </div>`;
  }
  body.innerHTML = html;
  renderCalDetail();
  renderLongLists();
}
