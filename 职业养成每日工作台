/* ===== 大模型通用调用（OpenAI 兼容协议） ===== */
async function callLlm(systemPrompt, userPrompt){
  if(!aiEnabled()) throw new Error("未配置 API Key");
  const p = currentProvider();
  const model = aiSettings.model.trim() || p.defaultModel;
  const resp = await fetch(p.endpoint, {
    method:"POST",
    headers:{"Content-Type":"application/json","Authorization":"Bearer "+aiSettings.apiKey.trim()},
    body: JSON.stringify({model, messages:[
      {role:"system", content:systemPrompt},
      {role:"user", content:userPrompt}
    ], temperature:0.8})
  });
  if(!resp.ok){
    let msg = "";
    try{ const e = await resp.json(); msg = e.error?.message || ""; }catch(_){}
    throw new Error(`接口返回 ${resp.status}${msg?"："+msg.slice(0,120):""}`);
  }
  const data = await resp.json();
  const content = data.choices?.[0]?.message?.content;
  if(!content) throw new Error("接口未返回解读内容");
  return content.trim();
}
