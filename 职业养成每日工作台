function monthKey(){ return todayStr().slice(0,7); }
function normalizeCounters(){
  const c = state.counters;
  c.perTrackCount = c.perTrackCount||{};
  c.monthCount = c.monthCount||{};
  if(!c.perTrack) c.perTrack = {};
  if(!c.dayXp) c.dayXp = {};
}
function monthStats(){
  const mk = monthKey();
  let mXp = 0;
  Object.keys(state.counters.dayXp).forEach(k=>{ if(k.startsWith(mk)) mXp += state.counters.dayXp[k]; });
  return { xp:mXp, count: state.counters.monthCount[mk]||0 };
}
function achValue(ach){
  normalizeCounters();
  const ms = monthStats();
  switch(ach.type){
    case "xp": return state.totalXP;
    case "streak": return state.streak;
    case "count": return state.counters.all;
    case "track": return state.counters.perTrackCount[ach.trackId]||0;
    case "onceDone": return state.tasks.filter(t=>t.repeat==="once"&&t.done&&Object.keys(t.done).length).length;
    case "review": return state.reviewMonth?1:0;
    case "monthCount": return ms.count;
    case "monthXp": return ms.xp;
    default: return 0;
  }
