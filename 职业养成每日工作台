  {xp:6000,name:"一代宗师"}
];
const REPEAT_LABEL = {daily:"每日", weekly:"每周", monthly:"每月", once:"一次性"};

/* ================= AI 服务商配置 ================= */
const AI_STORAGE_KEY = "quest_ai_v1";
const AI_PROVIDERS = {
  doubao: {
    name:"豆包 · 火山方舟",
    endpoint:"https://ark.cn-beijing.volces.com/api/v3/chat/completions",
    defaultModel:"doubao-pro-32k",
    note:"模型 ID 填火山方舟接入点 ID（形如 ep-xxxxxxxx）或具体模型名；API Key 在火山方舟控制台「API Key 管理」获取。"
  },
  deepseek: {
    name:"DeepSeek",
    endpoint:"https://api.deepseek.com/chat/completions",
    defaultModel:"deepseek-chat",
    note:"模型可填 deepseek-chat（通用对话）或 deepseek-reasoner（深度推理）；API Key 在 platform.deepseek.com 获取。"
  },
  bailian: {
    name:"阿里云百炼（通义）",
    endpoint:"https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
    defaultModel:"qwen-plus",
    note:"走 OpenAI 兼容模式；模型可填 qwen-plus、qwen-max、qwen-turbo 等；API Key 在百炼控制台获取。"
  }
};
function defaultAi(){
  return {provider:"deepseek", apiKey:"", model:"", dirs:null, customDirs:"", birth:{date:"",hour:2,place:""}};
}
function loadAi(){
  try{
    const raw = localStorage.getItem(AI_STORAGE_KEY);
    if(!raw) return defaultAi();
    const p = JSON.parse(raw);
    return Object.assign(defaultAi(), p, {birth:Object.assign(defaultAi().birth, p.birth||{})});
  }catch(e){ return defaultAi(); }
}
function saveAi(){ try{ localStorage.setItem(AI_STORAGE_KEY, JSON.stringify(aiSettings)); }catch(e){} }
function aiEnabled(){ return !!aiSettings.apiKey.trim(); }
function currentProvider(){ return AI_PROVIDERS[aiSettings.provider]||AI_PROVIDERS.deepseek; }
/* 当前解读方向：选中的赛道 + 自定义补充，随模块增删动态读取 */
function currentDirections(){
  const trackDirs = state.tracks
    .filter(t => aiSettings.dirs===null || aiSettings.dirs.includes(t.id))
    .map(t => ({name:t.name, tag:t.tag||"", source:"赛道"}));
  const custom = aiSettings.customDirs.split(/\r?\n/).map(s=>s.trim()).filter(Boolean)
    .map(s => ({name:s, tag:"", source:"自定义"}));
  return [...trackDirs, ...custom];
}

/* ================= 默认数据 ================= */
function defaultState(){
  const tracks = [
    {id:"phd",   name:"海外博士",   tag:"主线 · 三校申请", color:"#e8a84e", goal:1000},
    {id:"media", name:"设计师自媒体", tag:"现金流支线 · 传播", color:"#5fc4ae", goal:600},
    {id:"civil", name:"考公考编",   tag:"保底支线 · 晚成", color:"#9a8bd0", goal:400},
    {id:"teach", name:"数字媒体教师", tag:"过渡资产 · 配印", color:"#d9725f", goal:400}
  ];
  const tasks = [
    {id:"p1",trackId:"phd",text:"雅思词汇 30 个（句子里记）",xp:20,repeat:"daily",weekDays:[],monthDay:1,start:"",due:"",done:{}},
    {id:"p2",trackId:"phd",text:"听力或精读 30 分钟",xp:20,repeat:"daily",weekDays:[],monthDay:1,start:"",due:"",done:{}},
    {id:"p3",trackId:"phd",text:"作品集整理或迭代 1 项",xp:20,repeat:"weekly",weekDays:[2,5],monthDay:1,start:"",due:"",done:{}},
    {id:"p4",trackId:"phd",text:"精读 1 篇目标导师论文并记笔记",xp:25,repeat:"weekly",weekDays:[7],monthDay:1,start:"",due:"",done:{}},
    {id:"p5",trackId:"phd",text:"套磁信起草 / 跟进（长线推进到 12 月申请）",xp:30,repeat:"once",weekDays:[],monthDay:1,start:"2026-10-26",due:"2027-12-01",done:{}},
    {id:"p6",trackId:"phd",text:"RP 或文献笔记写 300 字",xp:25,repeat:"weekly",weekDays:[3,6],monthDay:1,start:"",due:"",done:{}},
    {id:"m1",trackId:"media",text:"完成 1 条图文 / 视频作品发布",xp:30,repeat:"weekly",weekDays:[6],monthDay:1,start:"",due:"",done:{}},
    {id:"m2",trackId:"media",text:"素材拍摄或剪辑 30 分钟",xp:20,repeat:"daily",weekDays:[],monthDay:1,start:"",due:"",done:{}},
    {id:"m3",trackId:"media",text:"选题策划与文案 1 条",xp:15,repeat:"monthly",weekDays:[],monthDay:1,start:"",due:"",done:{}},
    {id:"m4",trackId:"media",text:"评论区与粉丝互动 20 分钟",xp:10,repeat:"daily",weekDays:[],monthDay:1,start:"",due:"",done:{}},
    {id:"c1",trackId:"civil",text:"听完考编网课 1 节",xp:20,repeat:"daily",weekDays:[],monthDay:1,start:"",due:"",done:{}},
    {id:"c2",trackId:"civil",text:"刷题一组（30 题）",xp:20,repeat:"daily",weekDays:[],monthDay:1,start:"",due:"",done:{}},
    {id:"c3",trackId:"civil",text:"当日错题复盘",xp:15,repeat:"weekly",weekDays:[7],monthDay:1,start:"",due:"",done:{}},
    {id:"t1",trackId:"teach",text:"课件 / 教案打磨 1 份",xp:20,repeat:"monthly",weekDays:[],monthDay:15,start:"",due:"",done:{}},
    {id:"t2",trackId:"teach",text:"试讲或说课练习 20 分钟",xp:15,repeat:"weekly",weekDays:[4],monthDay:1,start:"",due:"",done:{}}
  ];
  return {
    nickname:"旅人", totalXP:0, todayXP:0, streak:0, lastActive:"",
    tracks, tasks,
    counters:{all:0, perTrack:{}, dayXp:{}, weekXp:0, weekKey:""},
    achUnlocked:[], customAch:[], reviewMonth:""
  };
}

/* ================= 状态读写 ================= */
let state = defaultState();
function load(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return;
    const p = JSON.parse(raw);
    const d = defaultState();
    state = Object.assign(d, p);
    state.counters = Object.assign(d.counters, p.counters||{});
    state.counters.perTrack = Object.assign({}, p.counters?.perTrack||{});
    state.counters.dayXp = Object.assign({}, p.counters?.dayXp||{});
    state.customAch = p.customAch||[];
    state.achUnlocked = p.achUnlocked||[];
  }catch(e){ state = defaultState(); }
}
function save(){ try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }catch(e){} }

/* ================= 日期工具 ================= */
function pad(n){ return String(n).padStart(2,"0"); }
function dateStr(d){ return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate()); }
function todayDate(){ return new Date(); }
function todayStr(){ return dateStr(todayDate()); }
function isoWeekDay(d){ const g = d.getDay(); return g===0?7:g; } // 1=周一…7=周日
function weekKey(d){ const x=new Date(d); x.setDate(x.getDate()-isoWeekDay(x)+1); return dateStr(x).slice(0,8); }
function inRange(task, ds){
  if(task.start && ds < task.start) return false;
  if(task.due && ds > task.due) return false;
  return true;
}
function taskOnDate(task, d){
  if(!inRange(task, dateStr(d))) return false;
  const ds = dateStr(d);
  if(task.repeat==="daily") return true;
  if(task.repeat==="weekly") return task.weekDays.includes(isoWeekDay(d));
  if(task.repeat==="monthly") return d.getDate()===task.monthDay;
  if(task.repeat==="once") return true;
  return false;
}
function isDone(task, ds){ return task.done && task.done[ds]===true; }
function resetDailyRoll(){
  const today = todayStr();
  if(state.lastActive === today) return;
  const y = new Date(); y.setDate(y.getDate()-1);
  state.streak = (state.lastActive === dateStr(y)) ? state.streak+1 : 1;
  state.lastActive = today;
  const wk = weekKey(todayDate());
  if(state.counters.weekKey !== wk){ state.counters.weekKey = wk; state.counters.weekXp = 0; }
  save();
}

/* ================= 基础计算 ================= */
function rankOf(xp){
  let cur = RANKS[0];
  RANKS.forEach(r=>{ if(xp>=r.xp) cur=r; });
  const idx = RANKS.indexOf(cur);
  return {cur, next:RANKS[idx+1], idx};
}
function trackById(id){ return state.tracks.find(t=>t.id===id); }
function todayTasks(){
  const d = todayDate(), ds = dateStr(d);
  return state.tasks.filter(t=>taskOnDate(t,d));
}
function taskSub(task){
  if(task.repeat==="daily") return "每日重复";
  if(task.repeat==="weekly") return "每周 "+task.weekDays.map(w=>WEEK_NAMES[w-1]).join("、");
  if(task.repeat==="monthly") return "每月 "+task.monthDay+" 日";
  return "一次性长线"+(task.due?" · 截止 "+task.due:"");
}

/* ================= 渲染：HUD ================= */
function renderDate(){
  const d = todayDate();
  const wk = ["日","一","二","三","四","五","六"][d.getDay()];
  document.getElementById("dateLine").textContent =
    `今天 ${d.getFullYear()}.${pad(d.getMonth()+1)}.${pad(d.getDate())} 星期${wk} · 任务每日按规则刷新`;
  document.getElementById("nickInput").value = state.nickname;
}
function renderHUD(){
  const r = rankOf(state.totalXP);
  document.getElementById("rankBadge").textContent = "Lv."+(r.idx+1);
  document.getElementById("rankName").textContent = r.cur.name;
  const ds = todayStr();
  const todayXp = state.counters.dayXp[ds]||0;
  if(r.next){
    document.getElementById("xpText").textContent = `${state.totalXP} / ${r.next.xp} XP`;
    document.getElementById("xpBar").style.width = Math.min(100,Math.round((state.totalXP-r.cur.xp)/(r.next.xp-r.cur.xp)*100))+"%";
  }else{
    document.getElementById("xpText").textContent = `${state.totalXP} XP · 已满级`;
    document.getElementById("xpBar").style.width = "100%";
  }
