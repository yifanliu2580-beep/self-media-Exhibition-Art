];
/* 节气近似分界：进入某月支的公历日期（月,日,月支序号） */
const SOLAR_CUT = [
  [1,6,1],[2,4,2],[3,6,3],[4,5,4],[5,6,5],[6,6,6],
  [7,7,7],[8,8,8],[9,8,9],[10,8,10],[11,7,11],[12,7,0]
];
function monthBranch(m, d){
  let br = 0;
  SOLAR_CUT.forEach(c=>{ if(m>c[0] || (m===c[0] && d>=c[1])) br=c[2]; });
  return br;
}
function tenGod(dayGan, otherGan){
  if(dayGan===otherGan) return "日主";
  const dw = WUXING_GAN[dayGan], ow = WUXING_GAN[otherGan];
  const sameYin = YANG_GAN.has(dayGan) === YANG_GAN.has(otherGan);
  if(dw===ow) return sameYin?"比肩":"劫财";
  if(SHENG[dw]===ow) return sameYin?"食神":"伤官";
  if(KE[dw]===ow) return sameYin?"偏财":"正财";
  if(KE[ow]===dw) return sameYin?"七杀":"正官";
  if(SHENG[ow]===dw) return sameYin?"偏印":"正印";
  return "—";
}
function computeBazi(y, m, d, hourBr){
  // 年柱：立春（约 2/4）前归上一年
  const yy = (m>2 || (m===2 && d>=4)) ? y : y-1;
  const yStem = ((yy-4)%10+10)%10, yBr = ((yy-4)%12+12)%12;
  const mb = monthBranch(m, d);
  const yStart = ((yStem%5)*2+2)%10;               // 五虎遁，寅月起手
  const mStem = (yStart + (mb-2+12)%12) % 10;
  // 日柱：以 2000-01-01 戊午日（六十甲子序号 54）为基准
  const diff = Math.floor((Date.UTC(y,m-1,d) - Date.UTC(2000,0,1)) / 86400000);
  const di = ((54+diff)%60+60)%60;
  const dStem = di%10, dBr = di%12;
  const hStart = (dStem%5)*2;                       // 五鼠遁，子时起手
  const hStem = (hStart+hourBr)%10;
  const rows = [
    {gan:GAN[yStem], zhi:ZHI[yBr], role:"年柱", god:tenGod(GAN[dStem],GAN[yStem])},
    {gan:GAN[mStem], zhi:ZHI[mb],  role:"月柱", god:tenGod(GAN[dStem],GAN[mStem])},
    {gan:GAN[dStem], zhi:ZHI[dBr], role:"日主", god:"日主"},
    {gan:GAN[hStem], zhi:ZHI[hourBr], role:"时柱", god:tenGod(GAN[dStem],GAN[hStem])}
  ];
  rows.forEach(p=> p.nayin = NAYIN[p.gan+p.zhi] || "");
  return {
    pillars: rows,
    dayMaster: GAN[dStem],
    dayMasterWu: WUXING_GAN[GAN[dStem]],
    yearZhi: ZHI[yBr]
  };
}

function parseNumbers(raw){
  const s = raw.trim();
  if(!s) return null;
  const tokens = s.split(/\s+/).filter(Boolean).map(Number).filter(n=>!isNaN(n)&&n>0);
  if(tokens.length===2) return {up:tokens[0],down:tokens[1],dong:tokens[0]+tokens[1]};
  if(tokens.length===3) return {up:tokens[0],down:tokens[1],dong:tokens[2]};
  if(tokens.length===1 && s.length===1) return {up:tokens[0],down:tokens[0],dong:tokens[0]};
  if(s.length>=2){ const mid=Math.ceil(s.length/2); const a=+s.slice(0,mid), b=+s.slice(mid); if(a>0&&b>0) return {up:a,down:b,dong:a+b}; }
  return null;
}
function mod8(n){ return ((n-1)%8)+1; }
function mod6(n){ return ((n-1)%6)+1; }
function yaoToGua(three){ // [初,二,三] -> 卦号
  for(const k of Object.keys(BAGUA)){ if(BAGUA[k].yao.join()===three.join()) return +k; }
  return 1;
}
function relation(useWu, bodyWu){
  if(useWu===bodyWu) return {label:"体用比和", cls:"good", text:"内外同气，节奏顺畅，事情按既有路径推进即可。"};
  if(SHENG[useWu]===bodyWu) return {label:"用生体 · 得助", cls:"good", text:"外部资源、他人助力会偏向你，适合主动联络导师、合作方与平台。"};
  if(SHENG[bodyWu]===useWu) return {label:"体生用 · 耗泄", cls:"warn", text:"需要你持续付出与输出，回报在后段；注意分配精力，不要被支线吸干主线。"};
  if(KE[bodyWu]===useWu) return {label:"体克用 · 劳而可得", cls:"warn", text:"需要主动经营才能拿下，事在人为，适合啃硬任务。"};
  return {label:"用克体 · 阻力", cls:"warn", text:"外部约束与竞争感偏重，不宜硬碰；先守节奏、补短板，等时机转向再发力。"};
}
function castGua(raw){
  const p = parseNumbers(raw);
  if(!p) return null;
  const upN=mod8(p.up), downN=mod8(p.down), dong=mod6(p.dong);
  const up=BAGUA[upN], down=BAGUA[downN];
  const ben = [...down.yao, ...up.yao]; // index0初爻…index5上爻
  // 体用
  const useIsUp = dong>3;
  const bodyGua = useIsUp?down:up, useGua = useIsUp?up:down;
  // 互卦：二三四 / 三四五
  const huDown = [ben[1],ben[2],ben[3]], huUp=[ben[2],ben[3],ben[4]];
  const huDownN=yaoToGua(huDown), huUpN=yaoToGua(huUp);
  // 变卦
  const bian=[...ben]; bian[dong-1]=bian[dong-1]?0:1;
  const bianDownN=yaoToGua(bian.slice(0,3)), bianUpN=yaoToGua(bian.slice(3,6));
  const rel = relation(useGua.wu, bodyGua.wu);
  return {
    dong, upN, downN,
    ben:{guas:[downN,upN], yao:ben, name:GUA64[`${upN}-${downN}`]||"本卦", body:bodyGua, use:useGua, useIsUp},
    hu:{guas:[huDownN,huUpN], yao:[...BAGUA[huDownN].yao,...BAGUA[huUpN].yao], name:GUA64[`${huUpN}-${huDownN}`]||"互卦"},
    bian:{guas:[bianDownN,bianUpN], yao:bian, name:GUA64[`${bianUpN}-${bianDownN}`]||"变卦"},
    rel
  };
}
function yaoHtml(yaoArr, dongIdx, highlight){
  return yaoArr.map((y,i)=>{
    const dongCls = (highlight && i===dongIdx-1)?"dong":"";
    const mark = (highlight && i===dongIdx-1)?`<span class="yao-mark">动</span>`:"";
    return `<div class="yao ${y?"yang":"yin"} ${dongCls}">${mark}</div>`;
  }).join("");
}
